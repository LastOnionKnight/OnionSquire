<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>OnionSquire</AssemblyName>
    <RootNamespace>OnionSquire</RootNamespace>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
    <Author>LastOnionKnight</Author>
    <Name>OnionSquire</Name>
    <Punchline>Smart retainer organizer &amp; armoire drawer for FFXIV.</Punchline>
    <Description>Organize retainers by role (crafting, gathering, food) and draw all armoire-eligible items to clean up retainer space.</Description>
    <RepoUrl>https://github.com/LastOnionKnight/OnionSquire</RepoUrl>
    <Tags>retainer;inventory;armoire;crafting;gathering;organization</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="CopyToInstalledPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PluginOutputs Include="$(TargetDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputs)" DestinationFolder="$(AppData)\XIVLauncher\installedPlugins\OnionSquire\0.1.1.0\" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(PluginOutputs)" DestinationFolder="$(AppData)\XIVLauncher\installedPlugins\OnionSquire\0.1.0.0\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
